#!/bin/bash
# AgentoC.app double-click entry: bootstrap first run, start the local
# chat server if it is not already running, then open the workbench URL.
set -euo pipefail

# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/agentoc-env.sh"

agentoc_source_instance_env
agentoc_first_run_bootstrap
agentoc_ensure_runtime_shims

PORT="${CHAT_PORT:-7690}"
BASE_URL="http://127.0.0.1:${PORT}"

mkdir -p "$(dirname "$AGENTOC_RUN_LOG")"

if agentoc_server_running; then
  open "$BASE_URL"
  exit 0
fi

nohup "$AGENTOC_NODE_BIN" "$AGENTOC_APP_DIR/chat-server.mjs" >>"$AGENTOC_RUN_LOG" 2>&1 &
echo $! > "$AGENTOC_PID_FILE"

for _ in $(seq 1 60); do
  if curl -sf -o /dev/null --max-time 1 "$BASE_URL/healthz" 2>/dev/null; then
    break
  fi
  sleep 0.5
done

open "$BASE_URL"
