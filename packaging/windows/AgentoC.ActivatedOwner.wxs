<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!--
    Full fresh-install lane. Owner identity and protected data are prepared,
    initialized, policy-bound, and activated only after the disabled virtual
    services and complete payload are installed. Existing state is refused;
    this package does not claim a migration from the legacy LocalSystem MSI.
  -->
  <?ifndef ProductCode?><?define ProductCode = "*"?><?endif?>
  <?ifndef MsiUpgradeLane?><?define MsiUpgradeLane = "major"?><?endif?>
  <?ifndef MsiUpgradeStrategy?><?define MsiUpgradeStrategy = "majorUpgrade"?><?endif?>
  <?ifndef ExperimentalMajorUpgrade?><?define ExperimentalMajorUpgrade = "0"?><?endif?>
  <!-- WiX 5+ otherwise supplies a default major upgrade, including RemoveExistingProducts. -->
  <Package Name="AgentoC" Manufacturer="AgentoC" Version="$(var.MsiProductVersion)" ProductCode="$(var.ProductCode)" UpgradeCode="2D1D9C6B-5BA7-4C70-9A7A-7E7A55E3A001" UpgradeStrategy="$(var.MsiUpgradeStrategy)" Scope="perMachine">
    <?if $(var.MsiUpgradeLane) = "major" ?>
      <?if $(var.ExperimentalMajorUpgrade) = "1" ?>
      <MajorUpgrade DowngradeErrorMessage="A newer AgentoC version is already installed." Schedule="afterInstallExecute" />
      <?else?>
      <MajorUpgrade DowngradeErrorMessage="A newer AgentoC version is already installed." Schedule="afterInstallInitialize" />
      <?endif?>
      <Property Id="AGENTOC_MAJOR_UPDATE_UI" Value="1" />
    <?endif?>
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AgentoCIcon" SourceFile="!(bindpath.BrandAsset)\agentoc.ico" />
    <Property Id="ARPPRODUCTICON" Value="AgentoCIcon" />
    <Property Id="AGENTOC_INSTALLFOLDER" Secure="yes" />
    <Property Id="AGENTOC_RECOVERY_SOURCE" Secure="yes" />
    <Property Id="AGENTOC_LAUNCH" Secure="yes" />
    <CustomAction Id="SetSelectedInstallFolder" Directory="INSTALLFOLDER" Value="[AGENTOC_INSTALLFOLDER]" />
    <CustomAction Id="SetAgentoCLaunchTarget" Property="WixUnelevatedShellExecTarget" Value="[INSTALLFOLDER]payload\Desktop\AgentoC.exe" />
    <WixVariable Id="WixUIBannerBmp" Value="!(bindpath.BrandAsset)\wix-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="!(bindpath.BrandAsset)\wix-dialog.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open AgentoC" />
    <Property Id="MSIUNINSTALLSUPERSEDEDCOMPONENTS" Value="1" />
    <!-- Use Restart Manager for accurate, fast file-in-use detection while
         disabling its automatic restart mitigation in the ordinary UI. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" />
    <Property Id="MSIRMSHUTDOWN" Value="2" />
    <?if $(var.MsiUpgradeLane) = "minor" ?>
      <Property Id="AGENTOC_INPLACE_UPDATE" Value="1" />
      <!-- Executable payload files are immutable. A modified, unversioned file
           must not survive an in-place update under Windows Installer's normal
           versioning rules. Apply this before file costing on reinstall only. -->
      <SetProperty Id="REINSTALLMODE" Value="vamus" Before="CostInitialize" Sequence="execute" Condition="Installed AND REINSTALL AND NOT (REMOVE = &quot;ALL&quot;)" />
    <?else?>
      <!-- A validated recovery can retain files from an older installation
           whose internal file version is higher than the public MSI version.
           Fresh installs must lay down this package's own immutable payload. -->
      <SetProperty Id="REINSTALLMODE" Value="amus" Before="CostInitialize" Sequence="execute" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE = &quot;ALL&quot;)" />
    <?endif?>
    <CustomAction Id="LaunchAgentoC" BinaryRef="Wix4UtilCA_X64" DllEntry="WixUnelevatedShellExec" Execute="immediate" Return="check" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <EmbeddedUI Id="AgentoCMsiEmbeddedUI" SourceFile="!(bindpath.InstallUi)\AgentoC.MsiEmbeddedUI.dll" SupportBasicUI="yes">
        <EmbeddedUIResource Id="AgentoCEmbeddedLogo" Name="agentoc-android-logo.png" SourceFile="!(bindpath.InstallUi)\agentoc-android-logo.png" />
        <?if $(var.IncludeMingwUiRuntime) = 1 ?>
          <EmbeddedUIResource Id="AgentoCMingwThreadRuntime" Name="libwinpthread-1.dll" SourceFile="!(bindpath.InstallUi)\libwinpthread-1.dll" />
        <?endif ?>
      </EmbeddedUI>
      <Publish Dialog="ExitDialog" Control="Finish" Property="WixUnelevatedShellExecTarget" Value="[INSTALLFOLDER]payload\Desktop\AgentoC.exe" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchAgentoC" Order="2" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <Binary Id="ManagedOwnerMsiBridge" SourceFile="!(bindpath.ManagedBridge)\AgentoC.ManagedOwnerMsiBridge.exe" />
    <CustomAction Id="ManagedFreshGuard" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="fresh &quot;[UserSID]&quot; &quot;[INSTALLFOLDER].&quot; &quot;[AGENTOC_RECOVERY_SOURCE].&quot;" Execute="immediate" Return="check" />
    <CustomAction Id="ManagedRelocationRollback" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="relocation-rollback &quot;[INSTALLFOLDER].&quot;" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="ManagedRelocationPrepare" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="relocation-prepare &quot;[UserSID]&quot; &quot;[AGENTOC_RECOVERY_SOURCE].&quot; &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedRelocationCommit" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="relocation-commit &quot;[INSTALLFOLDER].&quot;" Execute="commit" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedRemoveGuard" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="remove-admission &quot;[INSTALLFOLDER].&quot;" Execute="immediate" Return="check" />
    <CustomAction Id="ManagedCloseDesktopBeforeValidation" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="close-desktop-current-user &quot;[INSTALLFOLDER].&quot;" Execute="immediate" Return="check" />
    <CustomAction Id="ManagedCloseDesktop" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="close-desktop &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedConfigureBrokerServiceTrust" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="configure-broker-service $(var.ProductVersion) $(var.BrokerSha256) &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedConfigureBrokerServiceTrustUpgrade" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="configure-broker-service $(var.ProductVersion) $(var.BrokerSha256) &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedBrokerOwnerReset" FileRef="PrivilegedBrokerBinary" ExeCommand="admin owner-reset" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedRemoveRollback" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="remove-rollback $(var.ProductVersion) $(var.BrokerSha256) &quot;[INSTALLFOLDER].&quot;" Execute="rollback" Impersonate="no" Return="ignore" />
    <!-- Admission needs an administrator token to inspect the protected owner
         state. Run it in the elevated transaction before any mutation. -->
    <?if $(var.MsiUpgradeLane) = "major" ?>
    <CustomAction Id="ManagedUpgradeGuard" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="upgrade-admission $(var.MsiProductVersion) &quot;[WIX_UPGRADE_DETECTED]&quot; &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <?else?>
    <CustomAction Id="ManagedUpgradeGuard" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="upgrade-admission $(var.MsiProductVersion) &quot;$(var.ProductCode)&quot; &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <?endif?>
    <CustomAction Id="ManagedUpgradeBegin" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="upgrade-begin &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedUpgradeRollback" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="upgrade-rollback &quot;[INSTALLFOLDER].&quot;" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="ManagedMajorBrokerRollback" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="restore-broker-after-major-rollback &quot;[INSTALLFOLDER].&quot;" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="ManagedPrepareExisting" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="upgrade-prepare &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedPreparePolicyExisting" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="upgrade-policy &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedUpgradeActivationCheck" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="upgrade-activation-check &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedUpgradeActivate" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="upgrade-activate &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedUpgradeCommit" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="upgrade-commit &quot;[INSTALLFOLDER].&quot;" Execute="commit" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedMaintenanceRefused" Error="AgentoC repair is disabled; use the signed in-place update package." />
    <CustomAction Id="ManagedMajorUpgradeRefused" Error="This MSI major upgrade is disabled until its rollback path is validated." />

    <!-- One rollback action covers the complete ordered fresh-install
         transaction. It is embedded in the MSI and runs before MSI reverses
         service/file installation. The bridge keeps failures quarantined. -->
    <CustomAction Id="ManagedInstallRollback" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="install-rollback &quot;[INSTALLFOLDER].&quot;" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="ManagedInstallCommit" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="install-commit &quot;[INSTALLFOLDER].&quot;" Execute="commit" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedPrepare" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="prepare &quot;[UserSID]&quot; &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedInitializeIdentity" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="initialize &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedPreparePolicy" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="policy &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedActivationCheck" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="activation-check &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedActivate" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="activate &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedRemove" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="remove &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />

    <?if $(var.TestPostActivationRollback) = 1 ?>
      <!-- A deferred failure executes inside InstallFinalize after the deferred
           ManagedActivate action has actually completed. An immediate Error
           action here would only fail while MSI was still scheduling actions. -->
      <CustomAction Id="ManagedInjectedPostActivationFailure" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="injected-failure &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
      <CustomAction Id="ManagedInjectedPostUpgradeFailure" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="injected-failure &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <?endif ?>
    <?if $(var.TestPostRemovalRollback) = 1 ?>
      <CustomAction Id="ManagedInjectedPostRemovalFailure" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="injected-remove-failure &quot;[INSTALLFOLDER].&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <?endif?>

    <InstallExecuteSequence>
      <Custom Action="SetSelectedInstallFolder" After="CostFinalize" Condition="AGENTOC_INSTALLFOLDER AND NOT Installed AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="SetAgentoCLaunchTarget" After="InstallFinalize" Condition="AGENTOC_LAUNCH = &quot;1&quot; AND NOT Installed" />
      <Custom Action="LaunchAgentoC" After="SetAgentoCLaunchTarget" Condition="AGENTOC_LAUNCH = &quot;1&quot; AND NOT Installed" />
      <!-- Refuse both the old SYSTEM install and prepared/active state before
           RemoveExistingProducts can make any change to an existing install. -->
      <?if $(var.MsiUpgradeLane) = "major" ?>
      <?if $(var.ExperimentalMajorUpgrade) = "1" ?>
      <!-- Flush only the read-only elevated guard before MSI removes the old
           product; receipts must remain intact for the old uninstall guard. -->
      <Custom Action="ManagedUpgradeGuard" After="InstallInitialize" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
      <!-- Rollback is registered before old-product removal, so it runs after
           the predecessor MSI has recreated its Broker service. -->
      <Custom Action="ManagedMajorBrokerRollback" After="ManagedUpgradeGuard" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
      <InstallExecute After="ManagedMajorBrokerRollback" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
      <Custom Action="ManagedUpgradeRollback" After="RemoveExistingProducts" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
      <Custom Action="ManagedUpgradeBegin" After="ManagedUpgradeRollback" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
      <?else?>
      <Custom Action="ManagedMajorUpgradeRefused" Before="RemoveExistingProducts" Condition="WIX_UPGRADE_DETECTED" />
      <?endif?>
      <?endif?>
      <Custom Action="ManagedFreshGuard" Before="InstallValidate" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="ManagedRemoveGuard" Before="InstallValidate" Condition="Installed AND REMOVE = &quot;ALL&quot;" />
      <Custom Action="ManagedCloseDesktopBeforeValidation" After="ManagedRemoveGuard" Condition="Installed AND REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ManagedCloseDesktop" Before="ManagedRemoveRollback" Condition="Installed AND REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ManagedRemoveRollback" Before="ManagedBrokerOwnerReset" Condition="Installed AND REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ManagedBrokerOwnerReset" Before="StopServices" Condition="Installed AND REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />

      <?if $(var.MsiUpgradeLane) = "minor" ?>
        <Custom Action="ManagedMaintenanceRefused" Before="InstallValidate" Condition="Installed AND NOT (REMOVE = &quot;ALL&quot;) AND NOT REINSTALL" />
        <Custom Action="ManagedUpgradeGuard" Before="ManagedUpgradeRollback" Condition="Installed AND REINSTALL AND NOT (REMOVE = &quot;ALL&quot;)" />
        <Custom Action="ManagedUpgradeRollback" Before="ManagedUpgradeBegin" Condition="Installed AND REINSTALL AND NOT (REMOVE = &quot;ALL&quot;)" />
        <Custom Action="ManagedUpgradeBegin" Before="StopServices" Condition="Installed AND REINSTALL AND NOT (REMOVE = &quot;ALL&quot;)" />
      <?else?>
        <Custom Action="ManagedMaintenanceRefused" Before="InstallValidate" Condition="Installed AND NOT (REMOVE = &quot;ALL&quot;)" />
      <?endif?>

      <Custom Action="ManagedRelocationRollback" Before="InstallFiles" Condition="AGENTOC_RECOVERY_SOURCE AND NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="ManagedRelocationPrepare" After="InstallFiles" Condition="AGENTOC_RECOVERY_SOURCE AND NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="ManagedInstallRollback" After="InstallServices" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="ManagedConfigureBrokerServiceTrust" After="ManagedInstallRollback" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="ManagedPrepare" After="ManagedConfigureBrokerServiceTrust" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="ManagedInitializeIdentity" After="ManagedPrepare" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="ManagedPreparePolicy" After="ManagedInitializeIdentity" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="ManagedActivationCheck" After="ManagedPreparePolicy" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="ManagedActivate" After="ManagedActivationCheck" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="ManagedInstallCommit" Before="InstallFinalize" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="ManagedRelocationCommit" After="ManagedInstallCommit" Condition="AGENTOC_RECOVERY_SOURCE AND NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE = &quot;ALL&quot;)" />

      <?if $(var.MsiUpgradeLane) = "minor" ?>
        <Custom Action="ManagedConfigureBrokerServiceTrustUpgrade" After="InstallServices" Condition="Installed AND REINSTALL AND NOT (REMOVE = &quot;ALL&quot;)" />
        <Custom Action="ManagedPrepareExisting" After="ManagedConfigureBrokerServiceTrustUpgrade" Condition="Installed AND REINSTALL AND NOT (REMOVE = &quot;ALL&quot;)" />
        <Custom Action="ManagedPreparePolicyExisting" After="ManagedPrepareExisting" Condition="Installed AND REINSTALL AND NOT (REMOVE = &quot;ALL&quot;)" />
        <Custom Action="ManagedUpgradeActivationCheck" After="ManagedPreparePolicyExisting" Condition="Installed AND REINSTALL AND NOT (REMOVE = &quot;ALL&quot;)" />
        <Custom Action="ManagedUpgradeActivate" After="ManagedUpgradeActivationCheck" Condition="Installed AND REINSTALL AND NOT (REMOVE = &quot;ALL&quot;)" />
        <Custom Action="ManagedUpgradeCommit" Before="InstallFinalize" Condition="Installed AND REINSTALL AND NOT (REMOVE = &quot;ALL&quot;)" />
      <?endif ?>
      <?if $(var.MsiUpgradeLane) = "major" ?>
      <?if $(var.ExperimentalMajorUpgrade) = "1" ?>
        <Custom Action="ManagedConfigureBrokerServiceTrustUpgrade" After="InstallServices" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
        <Custom Action="ManagedPrepareExisting" After="ManagedConfigureBrokerServiceTrustUpgrade" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
        <Custom Action="ManagedPreparePolicyExisting" After="ManagedPrepareExisting" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
        <Custom Action="ManagedUpgradeActivationCheck" After="ManagedPreparePolicyExisting" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
        <Custom Action="ManagedUpgradeActivate" After="ManagedUpgradeActivationCheck" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
        <Custom Action="ManagedUpgradeCommit" Before="InstallFinalize" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
      <?endif?>
      <?endif?>
      <?if $(var.TestPostActivationRollback) = 1 ?>
        <Custom Action="ManagedInjectedPostActivationFailure" After="ManagedActivate" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE = &quot;ALL&quot;)" />
        <?if $(var.MsiUpgradeLane) = "minor" ?>
          <Custom Action="ManagedInjectedPostUpgradeFailure" After="ManagedUpgradeActivate" Condition="Installed AND REINSTALL AND NOT (REMOVE = &quot;ALL&quot;)" />
        <?endif ?>
        <?if $(var.MsiUpgradeLane) = "major" ?>
          <?if $(var.ExperimentalMajorUpgrade) = "1" ?>
          <Custom Action="ManagedInjectedPostUpgradeFailure" After="ManagedUpgradeActivate" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
          <?endif?>
        <?endif?>
      <?endif ?>
      <Custom Action="ManagedRemove" Before="DeleteServices" Condition="Installed AND REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <?if $(var.TestPostRemovalRollback) = 1 ?>
        <Custom Action="ManagedInjectedPostRemovalFailure" After="DeleteServices" Condition="Installed AND REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <?endif ?>
    </InstallExecuteSequence>

    <Feature Id="Main" Title="AgentoC" Level="1">
      <ComponentRef Id="ManagedServiceHost" />
      <ComponentRef Id="ManagedStartMenuShortcut" />
      <ComponentRef Id="ManagedEventSource" />
      <ComponentRef Id="PrivilegedBrokerService" />
      <ComponentGroupRef Id="PayloadGroup" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AgentoC">
        <Directory Id="BROKERINSTALLFOLDER" Name="Broker" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="ApplicationProgramsFolder" Name="AgentoC" /></StandardDirectory>

    <Component Id="ManagedStartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="AgentoCStartMenuShortcut" Name="AgentoC" Target="[INSTALLFOLDER]payload\Desktop\AgentoC.exe" WorkingDirectory="INSTALLFOLDER" Icon="AgentoCIcon" IconIndex="0" Advertise="no" />
      <RemoveFolder Id="RemoveAgentoCProgramMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\AgentoC\DesktopManager" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="ManagedEventSource" Directory="INSTALLFOLDER" Guid="*">
      <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\AgentoC">
        <RegistryValue Name="EventMessageFile" Type="string" Value="[System64Folder]EventCreate.exe" />
        <RegistryValue Name="TypesSupported" Type="integer" Value="7" />
      </RegistryKey>
    </Component>

    <Component Id="ManagedServiceHost" Directory="INSTALLFOLDER" Guid="*">
      <File Id="ManagedHost" Source="!(bindpath.ServiceHost)\AgentoC.ServiceHost.exe" KeyPath="yes" />
      <ServiceInstall Id="ManagedControl" Name="AgentoC-ControlPlane" DisplayName="AgentoC Control Plane" Type="ownProcess" Start="disabled" Account="NT SERVICE\AgentoC-ControlPlane" ErrorControl="normal" Arguments="--role control --config-dir &quot;C:\ProgramData\AgentoC\instances\owner\config&quot; --instance-root &quot;C:\ProgramData\AgentoC\instances\owner&quot;">
        <ServiceDependency Id="AgentoC-RunnerSupervisor" />
        <PermissionEx Sddl="O:SYG:SYD:(A;;GA;;;SY)(A;;GA;;;BA)(A;;CCLCSWLOCRRC;;;IU)(A;;CCLCSWLOCRRC;;;SU)" />
      </ServiceInstall>
      <ServiceControl Id="ManagedControlControl" Name="AgentoC-ControlPlane" Stop="install" Remove="uninstall" />
      <ServiceInstall Id="ManagedExecutor" Name="AgentoC-RunnerSupervisor" DisplayName="AgentoC Runner Supervisor" Type="ownProcess" Start="disabled" Account="NT SERVICE\AgentoC-RunnerSupervisor" ErrorControl="normal" Arguments="--role supervisor --config-dir &quot;C:\ProgramData\AgentoC\instances\owner\executor\config&quot; --instance-root &quot;C:\ProgramData\AgentoC\instances\owner&quot;">
        <PermissionEx Sddl="O:SYG:SYD:(A;;GA;;;SY)(A;;GA;;;BA)(A;;CCLCSWLOCRRC;;;IU)(A;;CCLCSWLOCRRC;;;SU)" />
      </ServiceInstall>
      <ServiceControl Id="ManagedExecutorControl" Name="AgentoC-RunnerSupervisor" Stop="install" Remove="uninstall" />
      <!-- Services are created disabled. The protected owner transaction is
           the only code that starts them after all trust gates pass. -->
    </Component>

    <Component Id="PrivilegedBrokerService" Directory="BROKERINSTALLFOLDER" Guid="{6EE17079-43E5-4B73-80CA-9E5B946E8B21}">
      <File Id="PrivilegedBrokerBinary" Source="!(bindpath.PrivilegedBroker)\AgentoC.PrivilegedBroker.exe" KeyPath="yes" />
      <File Id="PrivilegedBrokerManifest" Source="!(bindpath.PrivilegedBroker)\AgentoC.PrivilegedBroker.manifest.json" />
      <ServiceInstall Id="PrivilegedBrokerInstall" Name="AgentoC-PrivilegedBroker" DisplayName="AgentoC Privileged Broker" Type="ownProcess" Start="auto" Account="LocalSystem" ErrorControl="normal">
      </ServiceInstall>
      <ServiceControl Id="PrivilegedBrokerControl" Name="AgentoC-PrivilegedBroker" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
    </Component>
  </Fragment>
</Wix>
