<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Preparation candidate only: no runtime activation, repair or upgrade. -->
  <Package Name="AgentoC Managed Owner Preparation" Manufacturer="AgentoC" Version="$(var.MsiProductVersion)" UpgradeCode="42CB1771-FF93-48F7-85A1-3148A8D5EF09" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer preparation candidate is installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="AGENTOC_OWNER_SID" Secure="yes" />
    <Binary Id="ManagedOwnerMsiBridge" SourceFile="!(bindpath.ManagedBridge)\AgentoC.ManagedOwnerMsiBridge.exe" />
    <CustomAction Id="ManagedFreshGuard" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="fresh &quot;[AGENTOC_OWNER_SID]&quot; &quot;[INSTALLFOLDER].&quot;" Return="check" />
    <CustomAction Id="ManagedRemoveGuard" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="remove-admission" Return="check" />
    <CustomAction Id="ManagedMaintenanceRefused" Error="This preparation candidate supports fresh installation and removal of disabled prepared services only." />
    <CustomAction Id="ManagedPrepare" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="prepare &quot;[AGENTOC_OWNER_SID]&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ManagedRemove" BinaryRef="ManagedOwnerMsiBridge" ExeCommand="remove" Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="ManagedFreshGuard" Before="InstallValidate" Condition="NOT Installed" />
      <Custom Action="ManagedRemoveGuard" Before="InstallValidate" Condition="Installed AND REMOVE = &quot;ALL&quot;" />
      <Custom Action="ManagedMaintenanceRefused" Before="InstallValidate" Condition="Installed AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="ManagedPrepare" After="InstallServices" Condition="NOT Installed" />
      <Custom Action="ManagedRemove" Before="RemoveFiles" Condition="Installed AND REMOVE = &quot;ALL&quot;" />
    </InstallExecuteSequence>
    <Feature Id="Main" Title="Disabled Owner preparation" Level="1">
      <ComponentRef Id="ManagedServiceHost" />
      <ComponentGroupRef Id="PayloadGroup" />
    </Feature>
  </Package>
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder"><Directory Id="INSTALLFOLDER" Name="AgentoC" /></StandardDirectory>
    <Component Id="ManagedServiceHost" Directory="INSTALLFOLDER" Guid="*">
      <File Id="ManagedHost" Source="!(bindpath.ServiceHost)\AgentoC.ServiceHost.exe" KeyPath="yes" />
      <ServiceInstall Id="ManagedControl" Name="AgentoC-ControlPlane" DisplayName="AgentoC Control Plane" Type="ownProcess" Start="disabled" Account="NT SERVICE\AgentoC-ControlPlane" ErrorControl="normal" Arguments="--role control --config-dir &quot;C:\ProgramData\AgentoC\instances\owner\config&quot; --instance-root &quot;C:\ProgramData\AgentoC\instances\owner&quot;">
        <ServiceDependency Id="AgentoC-RunnerSupervisor" />
      </ServiceInstall>
      <ServiceInstall Id="ManagedExecutor" Name="AgentoC-RunnerSupervisor" DisplayName="AgentoC Runner Supervisor" Type="ownProcess" Start="disabled" Account="NT SERVICE\AgentoC-RunnerSupervisor" ErrorControl="normal" Arguments="--role supervisor --config-dir &quot;C:\ProgramData\AgentoC\instances\owner\executor\config&quot; --instance-root &quot;C:\ProgramData\AgentoC\instances\owner&quot;" />
      <!-- No ServiceControl start/stop/remove: removal uses verified retained
           native handles and refuses active or changed registrations. -->
    </Component>
  </Fragment>
</Wix>
