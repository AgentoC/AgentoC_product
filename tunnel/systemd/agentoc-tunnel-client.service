# AgentoC reverse tunnel — remote peer (run on the NAT'd host, e.g. agentoc).
#
# Install as root on the remote host:
#   sudo cp agentoc-tunnel-client.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now agentoc-tunnel-client
#
# The client only makes one outbound HTTPS connection (TLS 443, ALPN h2);
# it never listens. Requires /home/agentoc/agentoc-tunnel/ with
# tunnel-client.mjs + tunnel-common.mjs, and the shared token at
# /home/agentoc/.agentoc-tunnel-token (mode 0600, owner agentoc).

[Unit]
Description=AgentoC reverse tunnel client (remote peer)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=agentoc
WorkingDirectory=/home/agentoc/agentoc-tunnel
ExecStart=/usr/bin/node tunnel-client.mjs --url https://tunnel.example.com/tunnel --target 127.0.0.1:7690 --token-file /home/agentoc/.agentoc-tunnel-token
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
