[Unit]
Description=Ragent agent mail HTTP bridge
After=network-online.target agentoc.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{repoCheckoutPath}}
EnvironmentFile=/etc/agentoc/install-profile.env
ExecStart=/usr/bin/env node {{repoCheckoutPath}}/scripts/agent-mail-http-bridge.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
