<resources>
    <!-- Night variant of Theme.Agentoc.Splash: resource configs replace wholesale, so
         the splash items are restated with dark-appropriate bar-icon appearance. -->
    <style name="Theme.Agentoc.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_symbol</item>
        <item name="postSplashScreenTheme">@style/Theme.Agentoc</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
